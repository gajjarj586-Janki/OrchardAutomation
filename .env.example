# Copy this file to .env and fill in real values locally.
# NEVER commit a real .env file. Never put real secrets in this example file.

# ---------------------------------------------------------------------------
# Environment / project
# APP_ENV selects config/environments/<APP_ENV>.yaml (dev, stage, prod all
# ship examples - see docs/configuration.md). Leave empty/"local" to use
# just config/default.yaml + config/local.yaml with no environment overlay.
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=dev
APP_BASE_URL=

# ---------------------------------------------------------------------------
# AI provider
# See docs/ai.md for supported providers. Leave AI_PROVIDER empty (or "mock")
# to run the framework with the built-in mock AI provider.
#
# To use the real Anthropic (Claude) provider: set AI_PROVIDER=anthropic,
# AI_API_KEY to a real Anthropic API key, and AI_MODEL to a Claude model id
# (see https://docs.anthropic.com/en/docs/about-claude/models).
#
# To use the real OpenAI provider instead: set AI_PROVIDER=openai,
# AI_API_KEY to a real OpenAI API key, and AI_MODEL to an OpenAI model id
# (see https://platform.openai.com/docs/models).
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# ---------------------------------------------------------------------------
# MCP (browser inspection) provider
# See docs/mcp.md. Leave MCP_PROVIDER empty to run with MCP disabled -
# the framework will clearly report MCP-dependent stages as SKIPPED.
#
# To use the real Playwright MCP adapter (Microsoft's official @playwright/mcp
# server, driven in-process - no separate server to run/host): set
# MCP_PROVIDER=playwright. MCP_SERVER_URL/MCP_API_KEY are not used by this
# adapter (it launches its own browser locally, honoring PW_CHANNEL below).
# ---------------------------------------------------------------------------
MCP_PROVIDER=
MCP_SERVER_URL=
MCP_API_KEY=

# ---------------------------------------------------------------------------
# Authentication (see docs/authentication.md)
# Never hardcode credentials in code, requirements, or features.
# ---------------------------------------------------------------------------
AUTH_USERNAME=
AUTH_PASSWORD=
